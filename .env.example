# DocPilot 环境变量示例（复制为 .env 或在实际平台控制台填写；.env 已被 gitignore）

# ---- 可选：LLM 提取大脑（不配置则用确定性离线引擎，功能完整）----
DOCPILOT_LLM_BASE=https://api.openai.com/v1
DOCPILOT_LLM_KEY=
DOCPILOT_LLM_MODEL=gpt-4o-mini

# ---- 可选：PayPal 催收/收款（沙盒）。不配置则催收链接降级为演示深链 ----
PAYPAL_BASE=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_MERCHANT=docpilot

# ---- 服务端口（Render/大部分 PaaS 自动注入）----
PORT=8000
